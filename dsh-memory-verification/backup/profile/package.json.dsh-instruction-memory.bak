    "dsh-office-tools": "^1.0.0",
    "dsh-pdf-edit": "^0.4.5",
    "dsh-pet": "^0.2.7",
    "dsh-plugin-writing-guard": "^2.0.1",
    "dsh-univer-office": "^0.2.14",
    "dsh-vibe-math": "^2.0.21",
