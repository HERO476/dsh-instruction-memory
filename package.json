{
  "name": "dsh-instruction-memory",
  "version": "1.0.2",
  "description": "DSH 指令记忆：在设置界面中维护可增删改的长期指令，并自动注入此后每一轮对话的系统提示词。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HERO476/dsh-instruction-memory.git"
  },
  "homepage": "https://github.com/HERO476/dsh-instruction-memory#readme",
  "bugs": {
    "url": "https://github.com/HERO476/dsh-instruction-memory/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "instruction-memory",
    "system-prompt",
    "settings"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "huangpeiyan",
  "scripts": {
    "test": "node smoke-test.mjs && node contract-test.mjs && node verify.mjs",
    "prepublishOnly": "node check-metadata.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
